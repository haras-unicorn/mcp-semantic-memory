  "query": "SELECT m.*\n       FROM memories m\n       WHERE m.forgotten_at IS NULL\n         AND to_tsvector('simple', m.content) @@ to_tsquery('simple', $1)\n       ORDER BY\n         ts_rank(to_tsvector('simple', m.content), to_tsquery('simple', $1))\n           DESC,\n         m.id\n       LIMIT $2",
